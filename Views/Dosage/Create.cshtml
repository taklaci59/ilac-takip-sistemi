@model ilactakipsistem.Models.DosageSchedule

@{
    ViewData["Title"] = "Yeni Doz Saati";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-card">
            <h4 class="mb-4"><i class="fas fa-calendar-plus text-accent mr-2"></i>Doz Zamanı Belirle</h4>
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="mb-3">
                    <label asp-for="MedicineId" class="control-label text-muted">İlaç Seçin</label>
                    <select asp-for="MedicineId" class="form-select bg-dark text-white border-purple" asp-items="ViewBag.MedicineId"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="ReminderTime" class="control-label text-muted"></label>
                    <input asp-for="ReminderTime" class="form-control bg-dark text-white border-purple" type="time" />
                    <span asp-validation-for="ReminderTime" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DosageAmount" class="control-label text-muted"></label>
                    <input asp-for="DosageAmount" class="form-control bg-dark text-white border-purple" step="0.5" type="number" />
                    <span asp-validation-for="DosageAmount" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-light">Vazgeç</a>
                    <button type="submit" class="btn btn-purple px-5">Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
