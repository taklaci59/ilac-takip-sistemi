@model IEnumerable<ilactakipsistem.Models.DosageSchedule>

@{
    ViewData["Title"] = "Doz Saatleri";
}

<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4><i class="fas fa-clock text-teal mr-2"></i>Sıklık ve Hatırlatıcılar</h4>
        <a asp-action="Create" class="btn btn-primary-calm px-4 py-2 f-large"><i class="fas fa-plus-circle mr-2"></i> Yeni Saat Ekle</a>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>İlaç</th>
                    <th>Saat</th>
                    <th>Doz Miktarı</th>
                    <th class="text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                <tr>
                    <td><div class="font-weight-bold">@item.Medicine?.Name</div></td>
                    <td><span class="badge bg-dark border-teal">@item.ReminderTime.ToString(@"hh\:mm")</span></td>
                    <td>@item.DosageAmount Adet/Doz</td>
                    <td class="text-right">
                         <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
