@model IEnumerable<ilactakipsistem.Models.Medicine>

@{
    ViewData["Title"] = "İlaçlarım";
}

<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4><i class="fas fa-pills text-teal mr-2"></i>Kayıtlı İlaçlar</h4>
        <a asp-action="Create" class="btn btn-primary-calm px-4 py-2 f-large"><i class="fas fa-plus-circle mr-2"></i> Yeni İlaç Ekle</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>İlaç Bilgisi</th>
                    <th>Stok</th>
                    <th>Birim</th>
                    <th>Kritik Seviye</th>
                    <th class="text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                <tr>
                    <td>
                        <div class="font-weight-bold">@item.Name</div>
                        <small class="text-muted">@item.Description</small>
                    </td>
                    <td>
                        <span class="@(item.StockQuantity <= item.CriticalStockLevel ? "text-danger font-weight-bold" : "")">
                            @item.StockQuantity
                        </span>
                    </td>
                    <td>@item.Unit</td>
                    <td>@item.CriticalStockLevel</td>
                    <td class="text-right">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm mx-1">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm mx-1">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
