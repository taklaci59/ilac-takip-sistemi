@model ilactakipsistem.Models.Medicine

@{
    ViewData["Title"] = "İlaç Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="glass-card">
            <h4 class="mb-4"><i class="fas fa-edit text-accent mr-2"></i>@Model.Name Düzenleniyor</h4>
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="control-label text-muted"></label>
                        <input asp-for="Name" class="form-control bg-dark text-white border-purple" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Unit" class="control-label text-muted"></label>
                        <select asp-for="Unit" class="form-select bg-dark text-white border-purple">
                            <option value="Adet">Adet (Tablet/Kapsül)</option>
                            <option value="ml">Mililitre (ml)</option>
                            <option value="mg">Miligram (mg)</option>
                            <option value="Doz">Doz</option>
                        </select>
                        <span asp-validation-for="Unit" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="control-label text-muted"></label>
                    <textarea asp-for="Description" class="form-control bg-dark text-white border-purple" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StockQuantity" class="control-label text-muted"></label>
                        <input asp-for="StockQuantity" class="form-control bg-dark text-white border-purple" type="number" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CriticalStockLevel" class="control-label text-muted"></label>
                        <input asp-for="CriticalStockLevel" class="form-control bg-dark text-white border-purple" type="number" />
                        <span asp-validation-for="CriticalStockLevel" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-light">İptal</a>
                    <button type="submit" class="btn btn-purple px-5">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
